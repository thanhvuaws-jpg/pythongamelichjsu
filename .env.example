# Sao chép thành backend/.env rồi điền giá trị thật. KHÔNG commit file .env
DATABASE_URL=postgresql+asyncpg://sukydieutra:devpassword@localhost:5432/sukydieutra
JWT_SECRET=change-me
ANALYTICS_HMAC_SECRET=change-me
CORS_ORIGINS=http://localhost:8000,http://localhost:8080
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
WEB_BASE_URL=http://127.0.0.1:8000
# Bật khi chưa có dịch vụ gửi email: đăng ký xong dùng được ngay
SKIP_EMAIL_VERIFICATION=true
# Tài khoản quản trị đầu tiên, tạo khi máy chủ khởi động
ADMIN_EMAIL=
ADMIN_PASSWORD=
# console | smtp | resend
EMAIL_BACKEND=console
EMAIL_FROM=Sử Ký Điều Tra <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
